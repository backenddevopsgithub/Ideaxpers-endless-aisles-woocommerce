{
  "name": "ideaxperts/endless-aisles-woocommerce",
  "description": "IdeaXperts Endless Aisles integration foundation for WooCommerce.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^6.4",
    "php-stubs/woocommerce-stubs": "^11.1",
    "phpunit/phpunit": "^10.5",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "IdeaXperts\\EndlessAisles\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "IdeaXperts\\EndlessAisles\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "composer-validate": "composer validate --strict",
    "lint": "@php tools/lint.php",
    "cs": "phpcs",
    "phpstan": "phpstan analyse --memory-limit=1G",
    "test": "phpunit",
    "check": ["@composer-validate", "@lint", "@cs", "@phpstan", "@test"],
    "build-release": "php tools/build-release.php"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
